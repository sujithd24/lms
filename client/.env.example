# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_LOCAL_URL=http://localhost:3001

# Stripe Configuration
NEXT_PUBLIC_STRIPE_PUBLIC_KEY=pk_test_your_stripe_public_key

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# Judge0 Online Compiler (optional)
NEXT_PUBLIC_RAPIDAPI_KEY=your_rapidapi_key

# Demo login buttons on /signin (optional; panel is hidden when unset).
# These are sent to the browser, so only use throwaway demo-account passwords.
# Wrap values in double quotes: an unquoted # starts a comment in .env files.
NEXT_PUBLIC_DEMO_STUDENT_PASSWORD=
NEXT_PUBLIC_DEMO_TEACHER_PASSWORD=
