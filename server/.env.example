# Server Configuration
PORT=8001
NODE_ENV=development

# MongoDB (required in production)
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/lms?retryWrites=true&w=majority
# Local development defaults to mongodb://127.0.0.1:27017/lms when unset
MONGODB_URI=

# CORS
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000

# AWS (only used for S3 video uploads)
AWS_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.cloudfront.net
AWS_ACCESS_KEY=your-access-key
AWS_SECRET_KEY=your-secret-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key

# Clerk Authentication
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key

# OpenAI (optional)
NEXT_PUBLIC_OPENAI_API_KEY=your_openai_api_key

# Load sample courses on startup, but ONLY into an empty database (never wipes data)
# SEED_ON_START=true

# Only for `npm run migrate:dynamo` (copying old DynamoDB data into MongoDB)
# DYNAMODB_ENDPOINT=http://localhost:8000
